{
  "mcpServers": {
    "evor": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dist/index.cjs"
      ]
    },
    "semantic-scholar": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/bin/py-mcp.cjs",
        "semantic-scholar-mcp"
      ]
    },
    "arxiv": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/bin/py-mcp.cjs",
        "arxiv-mcp-server"
      ]
    },
    "hf-mcp": {
      "type": "http",
      "url": "https://huggingface.co/mcp"
    }
  }
}
