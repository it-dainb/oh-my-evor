{
  "mcpServers": {
    "evor": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/dist/index.cjs"]
    },
    "semantic-scholar": {
      "command": "uvx",
      "args": ["semantic-scholar-mcp"]
    },
    "arxiv": {
      "command": "uvx",
      "args": ["arxiv-mcp-server"]
    },
    "hf-mcp": {
      "type": "http",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer ${HF_TOKEN:-}"
      }
    }
  }
}
