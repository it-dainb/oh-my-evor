{
  "name": "oh-my-evor",
  "displayName": "oh-my-evor",
  "version": "0.6.0",
  "description": "Autonomous ML research evolution engine for Claude Code",
  "author": {
    "name": "oh-my-evor contributors"
  },
  "repository": "https://github.com/it-dainb/oh-my-evor",
  "homepage": "https://github.com/it-dainb/oh-my-evor",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "plugin",
    "ml-research",
    "evolution",
    "multi-agent",
    "autonomous"
  ],
  "skills": [
    "./skills/evor/",
    "./skills/evor-setup/",
    "./skills/evor-run/",
    "./skills/evor-dashboard/",
    "./skills/evor-report/",
    "./skills/evor-validate/",
    "./skills/evor-doctor/",
    "./skills/evor-gotchas/",
    "./skills/evor-distill/",
    "./skills/evor-mcp-setup/",
    "./skills/evor-mcp/",
    "./skills/evor-schedule/"
  ],
  "agents": [
    "./agents/evor-sage.md",
    "./agents/evor-mutagen.md",
    "./agents/evor-probe.md",
    "./agents/evor-forge.md",
    "./agents/evor-selector.md",
    "./agents/evor-sage-junior.md",
    "./agents/evor-forge-architect.md",
    "./agents/evor-forge-junior.md",
    "./agents/evor-forge-critic.md",
    "./agents/evor-forge-analyst.md",
    "./agents/evor-acquirer.md"
  ],
  "mcpServers": "./.mcp.json",
  "commands": "./commands/",
  "experimental": {
    "monitors": "./monitors/monitors.json"
  },
  "userConfig": {
    "hf_token": {
      "type": "string",
      "title": "Hugging Face Token",
      "description": "Read-only HF token for Papers Search, Dataset Search, and Hub Repository details via the Hugging Face MCP. Generate at https://huggingface.co/settings/tokens (read scope suffices). Leave blank for anonymous access to public resources at lower rate limits.",
      "sensitive": true,
      "required": false
    }
  }
}
