!mcp/dist/
!mcp/dist/index.cjs
harness/.venv/

# reference repos (read-only, not part of this project)
refs/

# evor runtime sentinels (not source)
.evor/.deps-ok
.evor/.uv-ok
.evor/.workspace-class

# omc runtime state (not source)
.omc/state/
.omc/project-memory.json
.omc/notepad.md

# HF token (never commit)
.evor/.env

# bundled python MCP venvs (built at runtime, not source)
mcp/.venvs/
mcp/.uv/

# runtime state anywhere in the tree (not source) — nested .omc/.evor
**/.omc/
.evor/runs/
.evor/active-run.json

# generated CI evidence artifacts
ci/out/

logs/

# Local benchmark mission scratch (see ci/bench-tick.sh — normally runs in-container)
.evor-bench/
